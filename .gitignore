# Binaries (only the built binary in the project root, not source directories)
# Anchored with leading / so that cmd/blastradius/ source directory is not ignored.
/blastradius
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# macOS
.DS_Store

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# Config (user-specific, though we don't persist secrets)
config.yaml
*.log

# Temporary sockets
/tmp/blastradius.sock
*.sock